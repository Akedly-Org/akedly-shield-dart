# Dart/Flutter build + tool output
.dart_tool/
.packages
build/
doc/api/

# Regenerated by any `flutter test`/`flutter pub get` run. Records absolute pub-cache paths
# and the local Flutter version, and its own first line says not to check it in.
.flutter-plugins-dependencies

# This is a LIBRARY package, not an application — pub's convention is that libraries do
# NOT commit their lock file, so consumers resolve against their own constraint set.
pubspec.lock

.DS_Store
